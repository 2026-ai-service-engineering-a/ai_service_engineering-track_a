const { variant = 'supervisor' } = Astro.props;
const map = MAPS[variant];
if (!map) throw new Error(`AgentMap: unknown variant "${variant}"`);
const [vw, vh] = map.view;
const details = Object.fromEntries(
  map.nodes.filter((n) => n.detail).map((n) => [n.id, { label: n.label, ...n.detail }]),
);
---

<div
  class="amap"
  data-agentmap
  data-initial={map.initial}
  data-details={JSON.stringify(details)}
>
  <div class="amap-head">
    <strong>{map.head}</strong>
    <span>{map.lede}</span>
  </div>

  <div class="amap-stage" style={`aspect-ratio: ${vw} / ${vh};`}>
    <svg viewBox={`0 0 ${vw} ${vh}`} aria-hidden="true">
      <defs>
        <marker id={`amap-arrow-${variant}`} viewBox="0 0 8 8" refX="7" refY="4"
          markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 0 L 8 4 L 0 8 z" fill="var(--amap-line)" />
        </marker>
      </defs>
      {map.edges.map((edge) => (
        <path
          d={edge.d}
          class:list={['amap-edge', { 'is-dashed': edge.dashed }]}
          marker-end={`url(#amap-arrow-${variant})`}
          marker-start={edge.both ? `url(#amap-arrow-${variant})` : undefined}
        />
      ))}
      {map.edges.filter((e) => e.label).map((edge) => (
        <text x={edge.lx} y={edge.ly} class="amap-edge-label">{edge.label}</text>
      ))}
    </svg>
    {map.nodes.map((node) =>
      node.detail ? (
        <button
          type="button"
          class={`amap-node is-${node.kind}`}
          data-node={node.id}
          style={`left: ${(node.x / vw) * 100}%; top: ${(node.y / vh) * 100}%;`}
        >
          <span class="amap-node-name">{node.label}</span>
          <span class="amap-node-sub">{node.sub}</span>
        </button>
      ) : (
        <div
          class={`amap-node is-${node.kind} is-static`}
          style={`left: ${(node.x / vw) * 100}%; top: ${(node.y / vh) * 100}%;`}
        >
          <span class="amap-node-name">{node.label}</span>
          <span class="amap-node-sub">{node.sub}</span>
        </div>
      ),
    )}
  </div>

  <div class="amap-panel" data-panel></div>

  <p class="amap-foot">{map.foot}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-agentmap]').forEach(init);

  function init(root: HTMLElement) {
    const details = JSON.parse(root.dataset.details ?? '{}') as Record<string, {
      label: string;
      badge: string;
      title: string;
      rows: { k: string; v: string }[];
      chips?: { label: string; items: string[]; muted?: boolean }[];
      note?: string;
    }>;
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-node]');
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    buttons.forEach((button) =>
      button.addEventListener('click', () => select(button.dataset.node ?? '')));
    select(root.dataset.initial ?? '');

    function select(id: string) {
      const d = details[id];
      if (!d) return;
      buttons.forEach((b) => b.classList.toggle('is-active', b.dataset.node === id));

      const chips = (d.chips ?? [])
        .map((group) => `<div class="amap-chips${group.muted ? ' is-muted' : ''}">
          <span class="amap-chips-label">${esc(group.label)}</span>
          ${group.items.map((item) => `<code>${esc(item)}</code>`).join('')}
        </div>`)
        .join('');

      panel.innerHTML = `
        <div class="amap-panel-head">
          <span class="amap-badge">${esc(d.badge)}</span>
          <strong>${esc(d.label)}</strong>
          <span class="amap-panel-title">${esc(d.title)}</span>
        </div>
        <dl class="amap-rows">
          ${d.rows.map((row) => `<div><dt>${esc(row.k)}</dt><dd>${esc(row.v)}</dd></div>`).join('')}
        </dl>
        ${chips}
        ${d.note ? `<p class="amap-note">${esc(d.note)}</p>` : ''}`;
    }
  }
</script>

<style>
  .amap {
    margin: 2rem 0;
    padding: 1.1rem 1.1rem 0.9rem;
    border: 1px solid var(--aas-border);
    border-radius: 14px;
    background: var(--aas-panel);
    box-shadow: var(--aas-shadow);
    font-family: var(--aas-sans);
    --amap-line: color-mix(in srgb, var(--aas-muted) 55%, transparent);
    --amap-router: #fab219;
    --amap-agent: #2f81f7;
    --amap-code: #8b949e;
    --amap-gate: #d0453f;
  }

  .amap-head { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.9rem; }
  .amap-head strong { font-size: 1rem; color: var(--aas-text); }
  .amap-head span { font-size: 0.85rem; line-height: 1.65; color: var(--aas-muted); }

  .amap-stage {
    position: relative;
    width: 100%;
    border: 1px solid var(--aas-border);
    border-radius: 10px;
    background: var(--aas-bg);
    overflow: hidden;
  }
  .amap-stage svg { position: absolute; inset: 0; width: 100%; height: 100%; }

  .amap-edge {
    fill: none;
    stroke: var(--amap-line);
    stroke-width: 1.6;
  }
  .amap-edge.is-dashed { stroke-dasharray: 5 4; }
  .amap-edge-label {
    font-size: 11px;
    fill: var(--aas-muted);
    font-family: var(--aas-sans);
  }

  .amap-node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.05rem;
    padding: 0.4rem 0.7rem;
    border-radius: 9px;
    border: 1.5px solid var(--aas-border);
    background: var(--aas-panel);
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    max-width: 30%;
  }
  .amap-node.is-static { cursor: default; border-style: dashed; }
  .amap-node:not(.is-static):hover { border-color: var(--aas-muted); }
  .amap-node.is-active { border-color: var(--amap-agent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--amap-agent) 22%, transparent); }
  .amap-node.is-router.is-active { border-color: var(--amap-router); box-shadow: 0 0 0 3px color-mix(in srgb, var(--amap-router) 25%, transparent); }
  .amap-node.is-gate.is-active { border-color: var(--amap-gate); box-shadow: 0 0 0 3px color-mix(in srgb, var(--amap-gate) 22%, transparent); }

  .amap-node-name { font-size: 0.8rem; font-weight: 650; color: var(--aas-text); white-space: nowrap; }
  .amap-node-sub { font-size: 0.66rem; color: var(--aas-muted); white-space: nowrap; }
  .amap-node.is-router .amap-node-name::before { content: '◆ '; color: var(--amap-router); }
  .amap-node.is-agent .amap-node-name::before { content: '● '; color: var(--amap-agent); }
  .amap-node.is-code .amap-node-name::before { content: '■ '; color: var(--amap-code); }
  .amap-node.is-gate .amap-node-name::before { content: '▲ '; color: var(--amap-gate); }

  .amap-panel {
    margin-top: 0.9rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--aas-border);
    border-radius: 10px;
    background: var(--aas-bg);
    min-height: 5rem;
  }
  .amap-panel :global(.amap-panel-head) {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem;
    margin-bottom: 0.55rem;
  }
  .amap-panel :global(.amap-badge) {
    font-size: 0.68rem; font-weight: 600;
    padding: 0.08rem 0.42rem; border-radius: 999px;
    border: 1px solid var(--aas-border); color: var(--aas-muted);
  }
  .amap-panel :global(strong) { font-size: 0.9rem; color: var(--aas-text); }
  .amap-panel :global(.amap-panel-title) { font-size: 0.8rem; color: var(--aas-muted); }

  .amap-panel :global(.amap-rows) { margin: 0; display: grid; gap: 0.35rem; }
  .amap-panel :global(.amap-rows > div) {
    display: grid; grid-template-columns: 6.4rem 1fr; gap: 0.6rem;
    font-size: 0.8rem; line-height: 1.6;
  }
  .amap-panel :global(dt) { color: var(--aas-muted); font-weight: 600; }
  .amap-panel :global(dd) { margin: 0; color: var(--aas-text); }

  .amap-panel :global(.amap-chips) {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem;
    margin-top: 0.55rem; font-size: 0.74rem;
  }
  .amap-panel :global(.amap-chips-label) { color: var(--aas-muted); font-weight: 600; margin-right: 0.15rem; }
  .amap-panel :global(.amap-chips code) {
    padding: 0.06rem 0.4rem; border-radius: 999px;
    border: 1px solid var(--aas-border); background: var(--aas-panel);
    font-size: 0.72rem;
  }
  .amap-panel :global(.amap-chips.is-muted code) { opacity: 0.55; text-decoration: line-through; }

  .amap-panel :global(.amap-note) {
    margin: 0.6rem 0 0; padding: 0.5rem 0.6rem;
    border-left: 3px solid var(--amap-router);
    background: var(--aas-tint);
    border-radius: 0 8px 8px 0;
    font-size: 0.78rem; line-height: 1.65; color: var(--aas-text);
  }

  .amap-foot { margin: 0.7rem 0 0; font-size: 0.76rem; color: var(--aas-muted); }

  @media (max-width: 34rem) {
    .amap-node-sub { display: none; }
    .amap-panel :global(.amap-rows > div) { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
