const [vw, vh] = map.view;
const byId = Object.fromEntries(map.nodes.map((n) => [n.id, n]));

interface Rendered { d: string; dashed?: boolean; both?: boolean; label?: string; lx: number; ly: number }
const edges: Rendered[] = map.edges.map((e) => {
  const a = byId[e.from], b = byId[e.to];
  const dx = b.cx - a.cx, dy = b.cy - a.cy;
  const len = Math.hypot(dx, dy);
  const ux = dx / len, uy = dy / len;
  const px = -uy, py = ux; // 수직 방향
  const bow = e.bow ?? 0;
  const sx = a.cx + ux * (a.r + 4) + px * bow * 0.25;
  const sy = a.cy + uy * (a.r + 4) + py * bow * 0.25;
  const ex = b.cx - ux * (b.r + 10) + px * bow * 0.25;
  const ey = b.cy - uy * (b.r + 10) + py * bow * 0.25;
  const cx = (sx + ex) / 2 + px * bow;
  const cy = (sy + ey) / 2 + py * bow;
  const lx = e.lx ?? 0.25 * sx + 0.5 * cx + 0.25 * ex + px * 16;
  const ly = e.ly ?? 0.25 * sy + 0.5 * cy + 0.25 * ey + py * 16;
  return { d: `M ${sx.toFixed(1)} ${sy.toFixed(1)} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${ex.toFixed(1)} ${ey.toFixed(1)}`,
    dashed: e.dashed, both: e.both, label: e.label, lx, ly };
});

// 원 내부 미니 다이어그램 레이아웃 (r=150 기준 좌표, r에 비례해 축소)
const STEP_W = 132, STEP_H = 36, STEP_GAP = 20, STEP_X = -46;
function stepYs(n: number): number[] {
  const total = n * STEP_H + (n - 1) * STEP_GAP;
  const top = -total / 2 + STEP_H / 2 + (n >= 4 ? 12 : 8);
  return Array.from({ length: n }, (_, i) => top + i * (STEP_H + STEP_GAP));
}
function pillYs(n: number): number[] {
  const gap = 34;
  const top = -((n - 1) * gap) / 2;
  return Array.from({ length: n }, (_, i) => top + i * gap);
}

const clickable = map.nodes.filter((n) => n.caption);
const clientData = {
  view: [vw, vh],
  nodes: clickable.map((n) => ({ id: n.id, label: n.label, cx: n.cx, cy: n.cy, r: n.r, caption: n.caption })),
};
---

<div class="amap" data-agentmap data-map={JSON.stringify(clientData)}>
  <div class="amap-head">
    <strong>{map.head}</strong>
    <span>{map.lede}</span>
  </div>

  <div class="amap-stage" style={`aspect-ratio: ${vw} / ${vh};`}>
    <div class="amap-canvas" data-canvas>
      <svg viewBox={`0 0 ${vw} ${vh}`} aria-hidden="true">
        <defs>
          <marker id={`amap-arrow-${variant}`} viewBox="0 0 8 8" refX="7" refY="4"
            markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 8 4 L 0 8 z" fill="var(--amap-line)" />
          </marker>
          <marker id={`amap-arrow-in-${variant}`} viewBox="0 0 8 8" refX="6" refY="4"
            markerWidth="5" markerHeight="5" orient="auto-start-reverse">
            <path d="M 0 0 L 8 4 L 0 8 z" fill="var(--amap-inner-line)" />
          </marker>
        </defs>

        {edges.map((edge) => (
          <path
            d={edge.d}
            class:list={['amap-edge', { 'is-dashed': edge.dashed }]}
            marker-end={`url(#amap-arrow-${variant})`}
            marker-start={edge.both ? `url(#amap-arrow-${variant})` : undefined}
          />
        ))}

        {map.nodes.map((node) => {
          const s = node.r / 150;
          const ys = node.inner ? stepYs(node.inner.steps.length) : [];
          const pys = node.inner?.side ? pillYs(node.inner.side.length) : [];
          const sideY = node.inner?.sideFrom !== undefined ? ys[node.inner.sideFrom] : 0;
          return (
            <g
              class:list={['amap-node', `is-${node.kind}`, { 'is-static': !node.caption }]}
              data-node={node.caption ? node.id : undefined}
              tabindex={node.caption ? 0 : undefined}
              role={node.caption ? 'button' : undefined}
            >
              <circle class="amap-circle" cx={node.cx} cy={node.cy} r={node.r} />
              <text class="amap-name" x={node.cx} y={node.cy - node.r + 30 * s} font-size={21 * s}>{node.label}</text>
              {node.inner && (
                <g transform={`translate(${node.cx}, ${node.cy + 8 * s}) scale(${s})`}>
                  {node.inner.steps.map((step, i) => (
                    <>
                      <rect class="amap-step" x={STEP_X - STEP_W / 2} y={ys[i] - STEP_H / 2}
                        width={STEP_W} height={STEP_H} rx={STEP_H / 2} />
                      <text class="amap-step-t" x={STEP_X} y={ys[i] + (step.s ? -1 : 4)}>{step.t}</text>
                      {step.s && <text class="amap-step-s" x={STEP_X} y={ys[i] + 12}>{step.s}</text>}
                      {i < node.inner!.steps.length - 1 && (
                        <line class="amap-inner-edge" x1={STEP_X} y1={ys[i] + STEP_H / 2}
                          x2={STEP_X} y2={ys[i + 1] - STEP_H / 2 - 4}
                          marker-end={`url(#amap-arrow-in-${variant})`} />
                      )}
                    </>
                  ))}
                  {node.inner.loop && (
                    <>
                      <path class="amap-inner-edge is-loop"
                        d={`M ${STEP_X - STEP_W / 2 - 2} ${ys[node.inner.loop.from]}
                            C ${STEP_X - STEP_W / 2 - 34} ${ys[node.inner.loop.from]},
                              ${STEP_X - STEP_W / 2 - 34} ${ys[node.inner.loop.to]},
                              ${STEP_X - STEP_W / 2 - 4} ${ys[node.inner.loop.to]}`}
                        marker-end={`url(#amap-arrow-in-${variant})`} />
                      <text class="amap-loop-t" x={STEP_X - STEP_W / 2 - 24}
                        y={(ys[node.inner.loop.from] + ys[node.inner.loop.to]) / 2 + 4}>{node.inner.loop.label}</text>
                    </>
                  )}
                  {node.inner.side?.map((pill, i) => (
                    <>
                      <line class="amap-inner-edge is-dash"
                        x1={STEP_X + STEP_W / 2} y1={sideY}
                        x2={40} y2={pys[i]} />
                      <rect class:list={['amap-pill', { 'is-muted': pill.muted }]}
                        x={40} y={pys[i] - 13} width={100} height={26} rx={13} />
                      <text class:list={['amap-pill-t', { 'is-muted': pill.muted }]}
                        x={90} y={pys[i] + 4}>{pill.t}</text>
                    </>
                  ))}
                </g>
              )}
            </g>
          );
        })}

        {edges.filter((e) => e.label).map((edge) => (
          <text x={edge.lx} y={edge.ly} class="amap-edge-label">{edge.label}</text>
        ))}
      </svg>
    </div>

    <div class="amap-bar" data-bar hidden>
      <button type="button" class="amap-back" data-back>← 지도</button>
      <div class="amap-tabs">
        {clickable.map((node) => (
          <button type="button" class="amap-tab" data-tab={node.id}>{node.label}</button>
        ))}
      </div>
    </div>
  </div>

  <div class="amap-caption" data-caption>
    <p class="amap-foot">{map.foot}</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-agentmap]').forEach(init);

  function init(root: HTMLElement) {
    const data = JSON.parse(root.dataset.map ?? '{}') as {
      view: [number, number];
      nodes: {
        id: string; label: string; cx: number; cy: number; r: number;
        caption: {
          badge: string; title: string;
          rows: { k: string; v: string }[];
          chips?: { label: string; items: string[]; muted?: boolean }[];
          note?: string;
        };
      }[];
    };
    const stage = root.querySelector<HTMLElement>('.amap-stage')!;
    const canvas = root.querySelector<HTMLElement>('[data-canvas]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const overview = caption.innerHTML;
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    let current = '';

    root.querySelectorAll<SVGGElement>('[data-node]').forEach((g) => {
      g.addEventListener('click', (event) => {
        event.stopPropagation();
        fly(g.dataset.node ?? '');
      });
      g.addEventListener('keydown', (event) => {
        if ((event as KeyboardEvent).key === 'Enter') fly(g.dataset.node ?? '');
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((button) =>
      button.addEventListener('click', () => fly(button.dataset.tab ?? '')));
    root.querySelector('[data-back]')?.addEventListener('click', reset);
    canvas.addEventListener('click', () => { if (current) reset(); });
    root.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Escape' && current) reset();
    });
    window.addEventListener('resize', () => { if (current) apply(current); });

    function fly(id: string) {
      const node = data.nodes.find((n) => n.id === id);
      if (!node || id === current) return;
      current = id;
      apply(id);
      bar.hidden = false;
      root.classList.add('is-zoomed');
      root.querySelectorAll('[data-tab]').forEach((b) =>
        b.classList.toggle('is-active', (b as HTMLElement).dataset.tab === id));
      root.querySelectorAll('[data-node]').forEach((g) =>
        g.classList.toggle('is-active', (g as SVGGElement).dataset.node === id));
      renderCaption(node);
    }

    function apply(id: string) {
      const node = data.nodes.find((n) => n.id === id);
      if (!node) return;
      // 조상(슬라이드 데크)이 transform으로 축소해도 어긋나지 않도록
      // 시각 좌표(getBoundingClientRect)가 아니라 레이아웃 픽셀을 쓴다.
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      const u = w / data.view[0];
      const k = Math.min(w, h) / (2 * node.r * 1.18 * u);
      const tx = w / 2 - k * node.cx * u;
      const ty = h / 2 - k * node.cy * u;
      canvas.style.transformOrigin = '0 0';
      canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${k})`;
    }

    function reset() {
      current = '';
      canvas.style.transform = '';
      bar.hidden = true;
      root.classList.remove('is-zoomed');
      root.querySelectorAll('[data-node]').forEach((g) => g.classList.remove('is-active'));
      caption.innerHTML = overview;
    }

    function renderCaption(node: (typeof data.nodes)[number]) {
      const c = node.caption;
      const chips = (c.chips ?? [])
        .map((group) => `<div class="amap-chips${group.muted ? ' is-muted' : ''}">
          <span class="amap-chips-label">${esc(group.label)}</span>
          ${group.items.map((item) => `<code>${esc(item)}</code>`).join('')}
        </div>`)
        .join('');
      caption.innerHTML = `
        <div class="amap-caption-head">
          <span class="amap-badge">${esc(c.badge)}</span>
          <strong>${esc(node.label)}</strong>
          <span>${esc(c.title)}</span>
        </div>
        <dl class="amap-rows">
          ${c.rows.map((row) => `<div><dt>${esc(row.k)}</dt><dd>${esc(row.v)}</dd></div>`).join('')}
        </dl>
        ${chips}
        ${c.note ? `<p class="amap-note">${esc(c.note)}</p>` : ''}`;
    }
  }
</script>

<style>
  .amap {
    margin: 2rem 0;
    padding: 1.1rem 1.1rem 0.9rem;
    border: 1px solid var(--aas-border);
    border-radius: 14px;
    background: var(--aas-panel);
    box-shadow: var(--aas-shadow);
    font-family: var(--aas-sans);
    container-type: inline-size;
    --amap-line: color-mix(in srgb, var(--aas-muted) 60%, transparent);
    --amap-inner-line: color-mix(in srgb, var(--aas-muted) 75%, transparent);
    --amap-router: #fab219;
    --amap-agent: #2f81f7;
    --amap-code: #8b949e;
    --amap-gate: #d0453f;
  }

  .amap-head { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.9rem; }
  .amap-head strong { font-size: clamp(1rem, 1.6cqw, 1.35rem); color: var(--aas-text); }
  .amap-head span { font-size: clamp(0.85rem, 1.3cqw, 1.1rem); line-height: 1.65; color: var(--aas-muted); }

  .amap-stage {
    position: relative;
    width: 100%;
    border: 1px solid var(--aas-border);
    border-radius: 10px;
    background: var(--aas-bg);
    overflow: hidden;
  }
  .amap-canvas {
    position: absolute; inset: 0;
    transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  .amap-canvas svg { position: absolute; inset: 0; width: 100%; height: 100%; }

  .amap-edge { fill: none; stroke: var(--amap-line); stroke-width: 1.8; }
  .amap-edge.is-dashed { stroke-dasharray: 6 5; }
  .amap-edge-label { font-size: 16px; fill: var(--aas-muted); font-family: var(--aas-sans); text-anchor: middle; }

  .amap-node { cursor: pointer; outline: none; }
  .amap-node.is-static { cursor: default; }
  .amap-circle {
    fill: var(--aas-panel);
    stroke: var(--aas-border);
    stroke-width: 2;
    transition: stroke 0.2s ease, stroke-width 0.2s ease;
  }
  .amap-node.is-static .amap-circle { stroke-dasharray: 6 5; }
  .amap-node:not(.is-static):hover .amap-circle,
  .amap-node:focus-visible .amap-circle { stroke-width: 3.5; }
  .amap-node.is-router:hover .amap-circle, .amap-node.is-router.is-active .amap-circle { stroke: var(--amap-router); }
  .amap-node.is-agent:hover .amap-circle, .amap-node.is-agent.is-active .amap-circle { stroke: var(--amap-agent); }
  .amap-node.is-code:hover .amap-circle, .amap-node.is-code.is-active .amap-circle { stroke: var(--amap-code); }
  .amap-node.is-gate:hover .amap-circle, .amap-node.is-gate.is-active .amap-circle { stroke: var(--amap-gate); }
  .amap-node.is-active .amap-circle { stroke-width: 3; }

  .amap-name {
    text-anchor: middle; font-weight: 700; fill: var(--aas-text);
    font-family: var(--aas-sans);
  }
  .amap-node.is-user .amap-name { font-size: 15px; font-weight: 600; }
  .amap-node.is-user .amap-name { transform: translateY(28px); }

  .amap-step { fill: var(--aas-bg); stroke: var(--amap-inner-line); stroke-width: 1.4; }
  .amap-step-t {
    font-size: 13px; font-weight: 650; fill: var(--aas-text);
    text-anchor: middle; font-family: var(--aas-sans);
  }
  .amap-step-s { font-size: 9.5px; fill: var(--aas-muted); text-anchor: middle; font-family: var(--aas-sans); }
  .amap-inner-edge { fill: none; stroke: var(--amap-inner-line); stroke-width: 1.4; }
  .amap-inner-edge.is-dash { stroke-dasharray: 4 4; stroke-width: 1.1; }
  .amap-loop-t { font-size: 10px; fill: var(--aas-muted); text-anchor: middle; font-family: var(--aas-sans); }
  .amap-pill { fill: var(--aas-bg); stroke: var(--amap-inner-line); stroke-width: 1.2; }
  .amap-pill.is-muted { stroke-dasharray: 3 3; opacity: 0.55; }
  .amap-pill-t {
    font-size: 10.5px; fill: var(--aas-text); text-anchor: middle;
    font-family: var(--aas-mono, monospace);
  }
  .amap-pill-t.is-muted { opacity: 0.55; }

  .amap-bar {
    position: absolute; top: 0.55em; left: 0.55em; right: 0.55em;
    display: flex; align-items: center; gap: 0.6em; flex-wrap: wrap;
    font-size: clamp(0.8rem, 1.4cqw, 1.1rem);
    pointer-events: none;
  }
  .amap-bar > * { pointer-events: auto; }
  .amap-back {
    padding: 0.3em 0.8em; border-radius: 999px;
    border: 1px solid var(--aas-border); background: var(--aas-panel);
    color: var(--aas-text); font-family: inherit; font-size: 0.92em; font-weight: 600;
    cursor: pointer; box-shadow: var(--aas-shadow);
  }
  .amap-back:hover { background: var(--aas-tint); }
  .amap-tabs { display: flex; flex-wrap: wrap; gap: 0.35em; }
  .amap-tab {
    padding: 0.24em 0.7em; border-radius: 999px;
    border: 1px solid var(--aas-border); background: var(--aas-panel);
    color: var(--aas-muted); font-family: inherit; font-size: 0.84em;
    cursor: pointer; box-shadow: var(--aas-shadow);
  }
  .amap-tab:hover { background: var(--aas-tint); }
  .amap-tab.is-active { color: var(--aas-text); border-color: var(--aas-muted); font-weight: 650; }

  .amap-caption {
    margin-top: 0.8rem;
    font-size: clamp(0.85rem, 1.6cqw, 1.25rem);
    min-height: 2.2em;
  }
  .amap-caption :global(.amap-caption-head) {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5em;
    margin-bottom: 0.5em;
  }
  .amap-caption :global(.amap-badge) {
    font-size: 0.72em; font-weight: 600;
    padding: 0.1em 0.5em; border-radius: 999px;
    border: 1px solid var(--aas-border); color: var(--aas-muted);
  }
  .amap-caption :global(.amap-caption-head strong) { font-size: 1.05em; color: var(--aas-text); }
  .amap-caption :global(.amap-caption-head span:last-child) { font-size: 0.88em; color: var(--aas-muted); }

  .amap-caption :global(.amap-rows) { margin: 0 0 0.3em; display: grid; gap: 0.35em; }
  .amap-caption :global(.amap-rows > div) {
    display: grid; grid-template-columns: 7.2em 1fr; gap: 0.7em;
    font-size: 0.86em; line-height: 1.6;
  }
  .amap-caption :global(dt) { color: var(--aas-muted); font-weight: 600; }
  .amap-caption :global(dd) { margin: 0; color: var(--aas-text); }

  .amap-caption :global(.amap-chips) {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35em;
    margin-top: 0.45em; font-size: 0.78em;
  }
  .amap-caption :global(.amap-chips-label) { color: var(--aas-muted); font-weight: 600; margin-right: 0.15em; }
  .amap-caption :global(.amap-chips code) {
    padding: 0.1em 0.5em; border-radius: 999px;
    border: 1px solid var(--aas-border); background: var(--aas-bg);
    font-size: 0.92em;
  }
  .amap-caption :global(.amap-chips.is-muted code) { opacity: 0.55; text-decoration: line-through; }

  .amap-caption :global(.amap-note) {
    margin: 0.55em 0 0; padding: 0.5em 0.7em;
    border-left: 3px solid var(--amap-router);
    background: var(--aas-tint);
    border-radius: 0 8px 8px 0;
    font-size: 0.82em; line-height: 1.65; color: var(--aas-text);
  }

  .amap-foot { margin: 0; font-size: clamp(0.76rem, 1.2cqw, 1rem); color: var(--aas-muted); }

  @media (prefers-reduced-motion: reduce) {
    .amap-canvas { transition: none; }
  }

  @media (max-width: 34rem) {
    .amap-caption :global(.amap-rows > div) { grid-template-columns: 1fr; gap: 0.1em; }
  }
</style>
