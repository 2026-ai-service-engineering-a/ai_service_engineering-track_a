            { name: 'LLM', desc: '상위 모델 고정' },
            { name: '한 파일 재작성', desc: 'tool_calls를 하나로 자른다' },
          ],
          rows: [
            { k: '왜 한 파일인가', v: '여러 파일을 한꺼번에 고치면 무엇이 나았는지 알 수 없다' },
            { k: '정지 조건', v: 'MAX_FIXES = 2' },
          ],
          note: '6주차 Reflexion이 여기서는 빌드 로그를 되먹이는 일이 됩니다.',
        },
      },
    ],
    edges: [
      { d: 'M 104 150 L 146 150' },
      { d: 'M 212 134 L 274 76', label: 'Send ×3', lx: 224, ly: 88 },
      { d: 'M 212 150 L 272 150' },
      { d: 'M 212 166 L 274 224' },
      { d: 'M 388 74 L 446 134' },
      { d: 'M 388 150 L 442 150' },
      { d: 'M 388 224 L 446 166' },
      { d: 'M 484 128 L 484 76', dashed: true, both: true, label: '고치기 ≤2', lx: 500, ly: 104 },
      { d: 'M 452 172 C 300 288 140 240 78 172', dashed: true, label: '재계획 ≤1', lx: 268, ly: 262 },
    ],
    foot: '실선: 제어 흐름 · 점선: 복구 루프 · 워커 셋은 같은 순간에 함께 돈다',
  },
};

const { variant = 'supervisor' } = Astro.props;
const map = MAPS[variant];
if (!map) throw new Error(`AgentMap: unknown variant "${variant}"`);
const [vw, vh] = map.view;
const clickable = map.nodes.filter((n) => n.detail);
const details = Object.fromEntries(
  clickable.map((n) => [n.id, { label: n.label, x: n.x / vw, y: n.y / vh, ...n.detail }]),
);
---

<div class="amap" data-agentmap data-details={JSON.stringify(details)}>
  <div class="amap-head">
    <strong>{map.head}</strong>
    <span>{map.lede}</span>
  </div>

  <div class="amap-stage" style={`aspect-ratio: ${vw} / ${vh};`}>
    <div class="amap-scene" data-scene>
      <svg viewBox={`0 0 ${vw} ${vh}`} aria-hidden="true">
        <defs>
          <marker id={`amap-arrow-${variant}`} viewBox="0 0 8 8" refX="7" refY="4"
            markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 0 L 8 4 L 0 8 z" fill="var(--amap-line)" />
          </marker>
        </defs>
        {map.edges.map((edge) => (
          <path
            d={edge.d}
            class:list={['amap-edge', { 'is-dashed': edge.dashed }]}
            marker-end={`url(#amap-arrow-${variant})`}
            marker-start={edge.both ? `url(#amap-arrow-${variant})` : undefined}
          />
        ))}
        {map.edges.filter((e) => e.label).map((edge) => (
          <text x={edge.lx} y={edge.ly} class="amap-edge-label">{edge.label}</text>
        ))}
      </svg>
      {map.nodes.map((node) =>
        node.detail ? (
          <button
            type="button"
            class={`amap-node is-${node.kind}`}
            data-node={node.id}
            style={`left: ${(node.x / vw) * 100}%; top: ${(node.y / vh) * 100}%;`}
          >
            <span class="amap-node-name">{node.label}</span>
            <span class="amap-node-sub">{node.sub}</span>
            <span class="amap-node-zoom">확대 ＋</span>
          </button>
        ) : (
          <div
            class={`amap-node is-${node.kind} is-static`}
            style={`left: ${(node.x / vw) * 100}%; top: ${(node.y / vh) * 100}%;`}
          >
            <span class="amap-node-name">{node.label}</span>
            <span class="amap-node-sub">{node.sub}</span>
          </div>
        ),
      )}
    </div>

    <div class="amap-zoom" data-zoom hidden>
      <div class="amap-zoom-bar">
        <button type="button" class="amap-back" data-back>← 지도</button>
        <div class="amap-tabs" data-tabs>
          {clickable.map((node) => (
            <button type="button" class={`amap-tab is-${node.kind}`} data-tab={node.id}>{node.label}</button>
          ))}
        </div>
      </div>
      <div class="amap-detail" data-detail></div>
    </div>
  </div>

  <p class="amap-foot">{map.foot}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-agentmap]').forEach(init);

  function init(root: HTMLElement) {
    const details = JSON.parse(root.dataset.details ?? '{}') as Record<string, {
      label: string; x: number; y: number;
      badge: string; title: string;
      flow: { name: string; desc?: string }[];
      loop?: string;
      rows: { k: string; v: string }[];
      chips?: { label: string; items: string[]; muted?: boolean }[];
      note?: string;
    }>;
    const scene = root.querySelector<HTMLElement>('[data-scene]')!;
    const zoom = root.querySelector<HTMLElement>('[data-zoom]')!;
    const panel = root.querySelector<HTMLElement>('[data-detail]')!;
    const nodes = root.querySelectorAll<HTMLButtonElement>('[data-node]');
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    nodes.forEach((button) =>
      button.addEventListener('click', () => open(button.dataset.node ?? '')));
    tabs.forEach((button) =>
      button.addEventListener('click', () => render(button.dataset.tab ?? '')));
    root.querySelector('[data-back]')?.addEventListener('click', close);
    root.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Escape' && !zoom.hidden) close();
    });

    function open(id: string) {
      const d = details[id];
      if (!d) return;
      scene.style.transformOrigin = `${d.x * 100}% ${d.y * 100}%`;
      scene.classList.add('is-zoomed');
      zoom.hidden = false;
      requestAnimationFrame(() => zoom.classList.add('is-open'));
      render(id);
    }

    function close() {
      scene.classList.remove('is-zoomed');
      zoom.classList.remove('is-open');
      window.setTimeout(() => { zoom.hidden = true; }, 220);
    }

    function render(id: string) {
      const d = details[id];
      if (!d) return;
      tabs.forEach((t) => t.classList.toggle('is-active', t.dataset.tab === id));

      const flow = d.flow
        .map((step) => `<div class="amap-step">
            <strong>${esc(step.name)}</strong>
            ${step.desc ? `<span>${esc(step.desc)}</span>` : ''}
          </div>`)
        .join('<span class="amap-step-arrow" aria-hidden="true">→</span>');
      const loop = d.loop ? `<div class="amap-loop">${esc(d.loop)}</div>` : '';

      const chips = (d.chips ?? [])
        .map((group) => `<div class="amap-chips${group.muted ? ' is-muted' : ''}">
          <span class="amap-chips-label">${esc(group.label)}</span>
          ${group.items.map((item) => `<code>${esc(item)}</code>`).join('')}
        </div>`)
        .join('');

      panel.innerHTML = `
        <div class="amap-panel-head">
          <span class="amap-badge">${esc(d.badge)}</span>
          <strong>${esc(d.label)}</strong>
          <span class="amap-panel-title">${esc(d.title)}</span>
        </div>
        <div class="amap-flow">${flow}</div>
        ${loop}
        <dl class="amap-rows">
          ${d.rows.map((row) => `<div><dt>${esc(row.k)}</dt><dd>${esc(row.v)}</dd></div>`).join('')}
        </dl>
        ${chips}
        ${d.note ? `<p class="amap-note">${esc(d.note)}</p>` : ''}`;
    }
  }
</script>

<style>
  .amap {
    margin: 2rem 0;
    padding: 1.1rem 1.1rem 0.9rem;
    border: 1px solid var(--aas-border);
    border-radius: 14px;
    background: var(--aas-panel);
    box-shadow: var(--aas-shadow);
    font-family: var(--aas-sans);
    container-type: inline-size;
    --amap-line: color-mix(in srgb, var(--aas-muted) 55%, transparent);
    --amap-router: #fab219;
    --amap-agent: #2f81f7;
    --amap-code: #8b949e;
    --amap-gate: #d0453f;
  }

  .amap-head { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.9rem; }
  .amap-head strong { font-size: clamp(1rem, 1.6cqw, 1.35rem); color: var(--aas-text); }
  .amap-head span { font-size: clamp(0.85rem, 1.3cqw, 1.1rem); line-height: 1.65; color: var(--aas-muted); }

  .amap-stage {
    position: relative;
    width: 100%;
    border: 1px solid var(--aas-border);
    border-radius: 10px;
    background: var(--aas-bg);
    overflow: hidden;
  }
  .amap-scene { position: absolute; inset: 0; transition: transform 0.28s ease, opacity 0.28s ease; }
  .amap-scene.is-zoomed { transform: scale(2.6); opacity: 0; pointer-events: none; }
  .amap-scene svg { position: absolute; inset: 0; width: 100%; height: 100%; }

  .amap-edge { fill: none; stroke: var(--amap-line); stroke-width: 1.6; }
  .amap-edge.is-dashed { stroke-dasharray: 5 4; }
  .amap-edge-label { font-size: 11px; fill: var(--aas-muted); font-family: var(--aas-sans); }

  .amap-node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.1em;
    padding: 0.55em 0.9em;
    border-radius: 10px;
    border: 1.5px solid var(--aas-border);
    background: var(--aas-panel);
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    max-width: 32%;
    font-size: clamp(0.8rem, 2cqw, 1.5rem);
  }
  .amap-node.is-static { cursor: default; border-style: dashed; }
  .amap-node:not(.is-static):hover { border-color: var(--amap-agent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--amap-agent) 18%, transparent); }
  .amap-node.is-router:hover { border-color: var(--amap-router); box-shadow: 0 0 0 3px color-mix(in srgb, var(--amap-router) 22%, transparent); }
  .amap-node.is-gate:hover { border-color: var(--amap-gate); box-shadow: 0 0 0 3px color-mix(in srgb, var(--amap-gate) 18%, transparent); }

  .amap-node-name { font-size: 1em; font-weight: 650; color: var(--aas-text); white-space: nowrap; }
  .amap-node-sub { font-size: 0.72em; color: var(--aas-muted); white-space: nowrap; }
  .amap-node-zoom {
    font-size: 0.62em; color: var(--aas-muted);
    opacity: 0; transition: opacity 0.15s ease;
  }
  .amap-node:not(.is-static):hover .amap-node-zoom { opacity: 1; }
  .amap-node.is-router .amap-node-name::before { content: '◆ '; color: var(--amap-router); }
  .amap-node.is-agent .amap-node-name::before { content: '● '; color: var(--amap-agent); }
  .amap-node.is-code .amap-node-name::before { content: '■ '; color: var(--amap-code); }
  .amap-node.is-gate .amap-node-name::before { content: '▲ '; color: var(--amap-gate); }

  .amap-zoom {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    background: var(--aas-bg);
    opacity: 0; transform: scale(0.94);
    transition: opacity 0.22s ease, transform 0.22s ease;
    overflow: auto;
  }
  .amap-zoom.is-open { opacity: 1; transform: scale(1); }

  .amap-zoom-bar {
    display: flex; align-items: center; gap: 0.7em; flex-wrap: wrap;
    padding: 0.7em 0.9em 0.4em;
    font-size: clamp(0.82rem, 1.6cqw, 1.2rem);
  }
  .amap-back {
    padding: 0.3em 0.8em; border-radius: 999px;
    border: 1px solid var(--aas-border); background: var(--aas-panel);
    color: var(--aas-text); font-family: inherit; font-size: 0.92em; font-weight: 600;
    cursor: pointer;
  }
  .amap-back:hover { background: var(--aas-tint); }
  .amap-tabs { display: flex; flex-wrap: wrap; gap: 0.35em; }
  .amap-tab {
    padding: 0.24em 0.7em; border-radius: 999px;
    border: 1px solid var(--aas-border); background: var(--aas-panel);
    color: var(--aas-muted); font-family: inherit; font-size: 0.84em;
    cursor: pointer;
  }
  .amap-tab:hover { background: var(--aas-tint); }
  .amap-tab.is-active { color: var(--aas-text); border-color: var(--aas-muted); font-weight: 650; }

  .amap-detail {
    flex: 1;
    padding: 0.4em 1em 1em;
    font-size: clamp(0.85rem, 1.75cqw, 1.3rem);
  }
  .amap-detail :global(.amap-panel-head) {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5em;
    margin-bottom: 0.7em;
  }
  .amap-detail :global(.amap-badge) {
    font-size: 0.72em; font-weight: 600;
    padding: 0.1em 0.5em; border-radius: 999px;
    border: 1px solid var(--aas-border); color: var(--aas-muted);
  }
  .amap-detail :global(.amap-panel-head strong) { font-size: 1.18em; color: var(--aas-text); }
  .amap-detail :global(.amap-panel-title) { font-size: 0.92em; color: var(--aas-muted); }

  .amap-detail :global(.amap-flow) {
    display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.45em;
    margin-bottom: 0.6em;
  }
  .amap-detail :global(.amap-step) {
    display: flex; flex-direction: column; gap: 0.15em; justify-content: center;
    padding: 0.5em 0.7em;
    border: 1px solid var(--aas-border); border-radius: 9px;
    background: var(--aas-panel);
    max-width: 15em;
  }
  .amap-detail :global(.amap-step strong) { font-size: 0.92em; color: var(--aas-text); }
  .amap-detail :global(.amap-step span) { font-size: 0.74em; line-height: 1.5; color: var(--aas-muted); }
  .amap-detail :global(.amap-step-arrow) { align-self: center; color: var(--aas-muted); font-size: 1.05em; }

  .amap-detail :global(.amap-loop) {
    display: inline-block;
    margin-bottom: 0.7em; padding: 0.3em 0.8em;
    border: 1px dashed var(--amap-agent); border-radius: 999px;
    color: var(--aas-text); font-size: 0.82em;
    background: color-mix(in srgb, var(--amap-agent) 8%, transparent);
  }

  .amap-detail :global(.amap-rows) { margin: 0 0 0.35em; display: grid; gap: 0.4em; }
  .amap-detail :global(.amap-rows > div) {
    display: grid; grid-template-columns: 7.2em 1fr; gap: 0.7em;
    font-size: 0.88em; line-height: 1.6;
  }
  .amap-detail :global(dt) { color: var(--aas-muted); font-weight: 600; }
  .amap-detail :global(dd) { margin: 0; color: var(--aas-text); }

  .amap-detail :global(.amap-chips) {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35em;
    margin-top: 0.5em; font-size: 0.8em;
  }
  .amap-detail :global(.amap-chips-label) { color: var(--aas-muted); font-weight: 600; margin-right: 0.15em; }
  .amap-detail :global(.amap-chips code) {
    padding: 0.1em 0.5em; border-radius: 999px;
    border: 1px solid var(--aas-border); background: var(--aas-panel);
    font-size: 0.92em;
  }
  .amap-detail :global(.amap-chips.is-muted code) { opacity: 0.55; text-decoration: line-through; }

  .amap-detail :global(.amap-note) {
    margin: 0.7em 0 0; padding: 0.55em 0.75em;
    border-left: 3px solid var(--amap-router);
    background: var(--aas-tint);
    border-radius: 0 8px 8px 0;
    font-size: 0.84em; line-height: 1.65; color: var(--aas-text);
  }

  .amap-foot { margin: 0.7rem 0 0; font-size: clamp(0.76rem, 1.2cqw, 1rem); color: var(--aas-muted); }

  @media (prefers-reduced-motion: reduce) {
    .amap-scene, .amap-zoom { transition: none; }
  }

  @media (max-width: 34rem) {
    .amap-node-sub, .amap-node-zoom { display: none; }
    .amap-detail :global(.amap-rows > div) { grid-template-columns: 1fr; gap: 0.1em; }
  }
</style>
