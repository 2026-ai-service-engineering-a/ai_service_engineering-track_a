/**
 * 멀티 에이전트 지도 (7주차 4·5·6장).
 *
 * 개요 지도에서 노드를 클릭하면 그 노드로 확대(zoom-in)되며 안쪽 해부도가
 * 열린다: 입력에서 출력까지의 흐름 카드, 도구 왕복 루프, 쥔 도구와 못 보는
 * 도구, 정지 조건. "지도" 버튼이나 Esc로 다시 축소한다.
 *
 * 수치는 전부 시연 저장소(week07-energy/support/coding-agent)의 코드에서
 * 읽은 값이다. 글자 크기는 컨테이너 폭에 비례한다(cqw) — 슬라이드처럼 넓은
 * 자리에서는 크게, 본문 폭에서는 알맞게 보인다.
 *
 * variant: "supervisor" | "handoff" | "parallel"
 */
interface FlowStep {
  name: string;
  desc?: string;
}
interface NodeDetail {
  badge: string;
  title: string;
  flow: FlowStep[];
  loop?: string;
  rows: { k: string; v: string }[];
  chips?: { label: string; items: string[]; muted?: boolean }[];
  note?: string;
}
interface MapNode {
  id: string;
  label: string;
  sub: string;
  kind: 'user' | 'router' | 'agent' | 'code' | 'gate';
  x: number;
  y: number;
  detail?: NodeDetail;
}
interface MapEdge {
  d: string;
  dashed?: boolean;
  both?: boolean;
  label?: string;
  lx?: number;
  ly?: number;
}
interface MapDef {
  head: string;
  lede: string;
  view: [number, number];
  nodes: MapNode[];
  edges: MapEdge[];
  foot: string;
}

