/**
 * 멀티 에이전트 지도 (7주차 4·5·6장).
 *
 * 노드를 클릭하면 그 자리의 안쪽이 열린다: 지침 길이, 쥔 도구와 못 보는
 * 도구, 안쪽 루프, 밖으로 내보내는 것, 정지 조건. 수치는 전부 시연
 * 저장소(week07-energy/support/coding-agent)의 코드에서 그대로 읽은 값이다.
 * 지침 길이는 프롬프트 원문에서 런타임 플레이스홀더를 뺀 글자 수.
 *
 * variant: "supervisor" | "handoff" | "parallel"
 */
interface NodeDetail {
  badge: string;
  title: string;
  rows: { k: string; v: string }[];
  chips?: { label: string; items: string[]; muted?: boolean }[];
  note?: string;
}
interface MapNode {
  id: string;
  label: string;
  sub: string;
  kind: 'user' | 'router' | 'agent' | 'code' | 'gate';
  x: number;
  y: number;
  detail?: NodeDetail;
}
interface MapEdge {
  d: string;
  dashed?: boolean;
  both?: boolean;
  label?: string;
  lx?: number;
  ly?: number;
}
interface MapDef {
  head: string;
  lede: string;
  view: [number, number];
  initial: string;
  nodes: MapNode[];
  edges: MapEdge[];
  foot: string;
}

