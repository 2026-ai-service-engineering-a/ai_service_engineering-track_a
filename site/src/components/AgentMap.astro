/**
 * 멀티 에이전트 지도 (7주차 4·5·6장) — 줌 캔버스판.
 *
 * 개요에서 각 에이전트는 원이고, 원 안에 그 에이전트의 안쪽 구조(지침 →
 * LLM → 도구, 루프, 곁가지 도구들)가 처음부터 작게 그려져 있다. 원을
 * 클릭하면 카메라가 그 원으로 연속적으로 날아 들어가 안쪽이 화면을 채우고,
 * 탭으로 옆 원으로 날아가거나 배경 클릭·Esc·"지도"로 다시 물러난다.
 *
 * 수치는 전부 시연 저장소(week07-energy/support/coding-agent)의 코드에서
 * 읽은 값이다. 아래 캡션의 상세(도구·정지 조건)는 확대한 노드를 따라간다.
 *
 * variant: "supervisor" | "handoff" | "parallel"
 */
interface InnerStep { t: string; s?: string }
interface InnerPill { t: string; muted?: boolean }
interface Inner {
  steps: InnerStep[];
  loop?: { from: number; to: number; label: string };
  side?: InnerPill[];
  sideFrom?: number;
}
interface Caption {
  badge: string;
  title: string;
  rows: { k: string; v: string }[];
  chips?: { label: string; items: string[]; muted?: boolean }[];
  note?: string;
}
interface MapNode {
  id: string;
  label: string;
  kind: 'user' | 'router' | 'agent' | 'code' | 'gate';
  cx: number; cy: number; r: number;
  inner?: Inner;
  caption?: Caption;
}
interface MapEdge { from: string; to: string; bow?: number; both?: boolean; dashed?: boolean; label?: string; lx?: number; ly?: number }
interface MapDef {
  head: string; lede: string; foot: string;
  view: [number, number];
  nodes: MapNode[];
  edges: MapEdge[];
}

