---
/**
 * 비용 게이트 시뮬레이터 (7주차 6장).
 *
 * 태스크 카드 3장의 난이도를 누르면 모델 배정과 견적이 바뀌고, 게이지가
 * 상한선을 넘는 순간 차단봉이 내려온다. 실행을 누르면 열린 문은 카드가
 * 그대로 통과하고, 닫힌 문은 사람에게 물은 뒤에야 움직인다 — 승인이면
 * 통과, 중단이면 한 줄도 짜지 않는다.
 *
 * 추정식은 `src/lib/multi-agent-rules.mjs`에 있고, week07-coding-agent의
 * `estimate_run`·`assign_model`을 그대로 옮긴 것이다. 단가는 litellm 가격표에서
 * 가져온 값이며, 파이썬 원본과 같은 입력 16건을 대조해 전부 일치한다
 * (원본 과정의 대조 기록). 실제 지출은 모델이 얼마나 뱉느냐에 달렸고, 그
 * 숫자는 교안의 실측표에 있다.
 */
const ROLES = [
  { id: 'backend', file: 'app.py' },
  { id: 'frontend', file: 'static/index.html' },
  { id: 'tests', file: 'tests/test_api.py' },
];
const BUDGETS = [0.01, 0.02, 0.05];
---

<div class="cg" data-cg>
  <div class="cg-head">
    <strong>값을 먼저 묻는 문</strong>
    <span>
      난이도를 눌러 모델 배정을 바꾸고, 실행을 눌러 보세요. 견적이 상한을
      넘는 순간 차단봉이 내려오고, 승인 없이는 카드가 한 장도 지나가지
      못합니다. 추정식은 week07-coding-agent의 <code>estimate_run</code> 그대로입니다.
    </span>
  </div>

  <div class="cg-ctl">
    <span class="cg-ctl-label">SPEC 길이</span>
    <input type="range" data-spec min="400" max="3000" step="100" value="800" />
    <span class="cg-spec-val" data-spec-val>800자</span>
    <span class="cg-ctl-label">상한</span>
    <div class="cg-chips">
      {BUDGETS.map((b) => (
        <button type="button" data-budget={b} class:list={[{ 'is-active': b === 0.02 }]}>${b.toFixed(2)}</button>
      ))}
    </div>
    <button type="button" class="cg-run" data-run>▶ 실행</button>
  </div>

  <div class="cg-stage" data-stage>
    <div class="cg-cards">
      {ROLES.map((role, i) => (
        <div class="cg-card" data-card={role.id} style={`--i: ${i};`}>
          <div class="cg-card-top">
            <strong>{role.id}</strong>
            <code>{role.file}</code>
          </div>
          <div class="cg-seg">
            <button type="button" data-diff="easy" class="is-active">쉬움</button>
            <button type="button" data-diff="hard">어려움</button>
          </div>
          <div class="cg-card-model"><span class="cg-model" data-model>저가 모델</span></div>
          <div class="cg-card-cost" data-cost></div>
        </div>
      ))}
    </div>

    <div class="cg-gate">
      <div class="cg-meter">
        <div class="cg-meter-track">
          <div class="cg-meter-budget" data-mbudget></div>
          <div class="cg-meter-fill" data-mfill></div>
        </div>
        <div class="cg-meter-nums">
          <span data-mtotal></span>
          <span data-mlimit></span>
        </div>
      </div>
      <div class="cg-door">
        <div class="cg-bar" data-bar></div>
        <div class="cg-door-frame"></div>
      </div>
      <div class="cg-gate-label" data-gate-label></div>
    </div>

    <div class="cg-out">
      <div class="cg-human" data-human hidden>
        <span>interrupt · 사람에게 묻습니다</span>
        <div>
          <button type="button" data-approve>승인</button>
          <button type="button" data-reject>중단</button>
        </div>
      </div>
      <div class="cg-result" data-result></div>
    </div>
  </div>

  <p class="cg-foot" data-foot></p>
</div>

<script>
  import { assignModel, estimateRun, gateDecision, TIER_MODEL }
    from '../lib/multi-agent-rules.mjs';

  document.querySelectorAll<HTMLElement>('[data-cg]').forEach(init);

  function init(root: HTMLElement) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const stage = $('[data-stage]');
    const human = $('[data-human]');
    const diffs: Record<string, string> = { backend: 'easy', frontend: 'easy', tests: 'easy' };
    let budget = 0.02;
    let spec = 800;
    const METER_MAX = 0.06;

    root.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      card.querySelectorAll<HTMLButtonElement>('[data-diff]').forEach((b) =>
        b.addEventListener('click', () => {
          diffs[card.dataset.card ?? ''] = b.dataset.diff ?? 'easy';
          card.querySelectorAll('[data-diff]').forEach((x) =>
            x.classList.toggle('is-active', x === b));
          render();
        }));
    });
    root.querySelectorAll<HTMLButtonElement>('[data-budget]').forEach((b) =>
      b.addEventListener('click', () => {
        budget = Number(b.dataset.budget);
        root.querySelectorAll('[data-budget]').forEach((x) =>
          x.classList.toggle('is-active', x === b));
        render();
      }));
    const specInput = $<HTMLInputElement>('[data-spec]');
    specInput.addEventListener('input', () => { spec = Number(specInput.value); render(); });
    $('[data-run]').addEventListener('click', run);
    $('[data-approve]').addEventListener('click', () => pass(true));
    $('[data-reject]').addEventListener('click', reject);
    render();

    function estimate() {
      const tasks = Object.entries(diffs).map(([role, difficulty]) => ({
        role, difficulty, model: assignModel(difficulty),
      }));
      return estimateRun(tasks, spec);
    }

    function render() {
      stage.classList.remove('is-passing', 'is-approved', 'is-stopped');
      human.hidden = true;
      $('[data-result]').textContent = '';
      $('[data-spec-val]').textContent = `${spec.toLocaleString('ko-KR')}자`;

      const est = estimate();
      est.perTask.forEach((t: { role: string; model: string; costUsd: number }) => {
        const card = root.querySelector<HTMLElement>(`[data-card="${t.role}"]`)!;
        const badge = card.querySelector<HTMLElement>('[data-model]')!;
        const strong = t.model === TIER_MODEL.strong;
        badge.textContent = strong ? '상위 모델' : '저가 모델';
        badge.classList.toggle('is-strong', strong);
        card.querySelector<HTMLElement>('[data-cost]')!.textContent = `$${t.costUsd.toFixed(4)}`;
      });

      const over = gateDecision(est.totalUsd, budget).asks;
      stage.classList.toggle('is-asks', over);
      $('[data-mfill]').style.height = `${Math.min(100, (est.totalUsd / METER_MAX) * 100)}%`;
      $('[data-mbudget]').style.bottom = `${Math.min(100, (budget / METER_MAX) * 100)}%`;
      $('[data-mtotal]').textContent = `견적 $${est.totalUsd.toFixed(4)}`;
      $('[data-mlimit]').textContent = `상한 $${budget.toFixed(2)}`;
      $('[data-gate-label]').textContent = over ? '문이 닫혀 있다' : '문은 열려 있다';
      $('[data-foot]').textContent = over
        ? '추정이 상한을 넘었습니다. 실행을 누르면 interrupt가 사람 앞에 섭니다.'
        : '추정이 상한 이내입니다. 실행을 누르면 묻지 않고 지나갑니다.';
    }

    function run() {
      render();
      const est = estimate();
      if (gateDecision(est.totalUsd, budget).asks) {
        human.hidden = false;
      } else {
        pass(false);
      }
    }

    function pass(approved: boolean) {
      human.hidden = true;
      const est = estimate();
      stage.classList.add(approved ? 'is-approved' : 'is-passing');
      stage.classList.remove('is-asks');
      $('[data-gate-label]').textContent = approved ? '승인 · 문이 열렸다' : '문은 열려 있다';
      $('[data-result]').textContent = '';
      $('[data-foot]').textContent = approved
        ? `승인 후 Send ×3. 카드가 문을 지나갔습니다 · 총 $${est.totalUsd.toFixed(4)} 예상`
        : `묻지 않고 지나갔습니다 · 총 $${est.totalUsd.toFixed(4)} 예상`;
    }

    function reject() {
      human.hidden = true;
      stage.classList.add('is-stopped');
      $('[data-gate-label]').textContent = '중단 (stopped)';
      $('[data-result]').textContent = '';
      $('[data-foot]').textContent = '거절 · stopped. 한 줄도 짜지 않았습니다.';
    }
  }
</script>

<style>
  .cg {
    margin: 2rem 0;
    padding: 1.1rem 1.1rem 0.9rem;
    border: 1px solid var(--aas-border);
    border-radius: 14px;
    background: var(--aas-panel);
    box-shadow: var(--aas-shadow);
    font-family: var(--aas-sans);
    container-type: inline-size;
    font-size: clamp(0.85rem, 1.5cqw, 1.2rem);
    --cg-accent: #2f81f7;
    --cg-warn: #d0453f;
    --cg-ok: #0ca30c;
    --cg-strong: #fab219;
  }

  .cg-head { display: flex; flex-direction: column; gap: 0.3em; margin-bottom: 0.8em; }
  .cg-head strong { font-size: 1.12em; color: var(--aas-text); }
  .cg-head span { font-size: 0.87em; line-height: 1.65; color: var(--aas-muted); }
  .cg-head code { font-size: 0.9em; }

  .cg-ctl {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5em 0.7em;
    margin-bottom: 0.8em;
  }
  .cg-ctl-label { font-size: 0.78em; color: var(--aas-muted); }
  .cg-ctl input[type='range'] { width: 9em; accent-color: var(--cg-accent); }
  .cg-spec-val { font-size: 0.8em; color: var(--aas-text); min-width: 3.6em; }
  .cg-chips { display: inline-flex; gap: 0.25em; }
  .cg-chips button {
    padding: 0.2em 0.6em; border-radius: 999px;
    border: 1px solid var(--aas-border); background: var(--aas-bg);
    color: var(--aas-muted); font-family: inherit; font-size: 0.78em; cursor: pointer;
  }
  .cg-chips button.is-active { border-color: var(--cg-accent); color: var(--cg-accent); font-weight: 650; }
  .cg-run {
    margin-left: auto;
    padding: 0.35em 1.1em; border-radius: 999px;
    border: 1px solid var(--cg-accent); background: var(--cg-accent);
    color: #fff; font-family: inherit; font-size: 0.88em; font-weight: 650; cursor: pointer;
  }

  .cg-stage {
    display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.8em;
    padding: 0.9em; border: 1px solid var(--aas-border); border-radius: 10px;
    background: var(--aas-bg);
    overflow: hidden;
  }

  .cg-cards { display: grid; gap: 0.5em; align-content: start; }
  .cg-card {
    padding: 0.55em 0.7em; border-radius: 10px;
    border: 1.5px solid var(--aas-border); background: var(--aas-panel);
    display: grid; gap: 0.3em;
    transition: transform 0.7s cubic-bezier(0.5, 0, 0.4, 1), opacity 0.5s ease;
    transition-delay: calc(var(--i) * 0.12s);
  }
  .cg-card-top { display: flex; align-items: baseline; gap: 0.5em; }
  .cg-card-top strong { font-size: 0.9em; color: var(--aas-text); }
  .cg-card-top code { font-size: 0.7em; color: var(--aas-muted); }
  .cg-seg { display: inline-flex; border: 1px solid var(--aas-border); border-radius: 999px; overflow: hidden; width: fit-content; }
  .cg-seg button {
    padding: 0.14em 0.6em; border: none; background: var(--aas-bg);
    color: var(--aas-muted); font-family: inherit; font-size: 0.74em; cursor: pointer;
  }
  .cg-seg button.is-active { background: var(--cg-accent); color: #fff; font-weight: 650; }
  .cg-model {
    font-size: 0.72em; font-weight: 650;
    padding: 0.08em 0.5em; border-radius: 999px;
    border: 1px solid var(--cg-ok); color: var(--cg-ok);
  }
  .cg-model.is-strong { border-color: var(--cg-strong); color: color-mix(in srgb, var(--cg-strong) 75%, var(--aas-text)); }
  .cg-card-cost { font-size: 0.76em; color: var(--aas-muted); }

  .cg-stage.is-passing .cg-card, .cg-stage.is-approved .cg-card {
    transform: translateX(calc(100% + 6.6em));
  }
  .cg-stage.is-approved .cg-card { border-color: var(--cg-strong); }
  .cg-stage.is-stopped .cg-card { opacity: 0.35; animation: cg-shake 0.35s ease; }
  @keyframes cg-shake {
    25% { transform: translateX(-5px); } 75% { transform: translateX(5px); }
  }

  .cg-gate { display: flex; gap: 0.7em; align-items: stretch; }
  .cg-meter { display: flex; flex-direction: column; align-items: center; gap: 0.3em; }
  .cg-meter-track {
    position: relative; width: 1.1em; flex: 1; min-height: 9em;
    border-radius: 999px; border: 1px solid var(--aas-border);
    background: color-mix(in srgb, var(--aas-muted) 10%, transparent);
    overflow: hidden;
  }
  .cg-meter-fill {
    position: absolute; left: 0; right: 0; bottom: 0;
    background: var(--cg-ok); border-radius: 999px;
    transition: height 0.45s ease, background 0.3s ease;
  }
  .cg-stage.is-asks .cg-meter-fill { background: var(--cg-warn); }
  .cg-meter-budget {
    position: absolute; left: -0.2em; right: -0.2em; height: 0;
    border-top: 2px dashed var(--aas-text); z-index: 1;
    transition: bottom 0.3s ease;
  }
  .cg-meter-nums { display: flex; flex-direction: column; gap: 0.1em; font-size: 0.68em; color: var(--aas-muted); text-align: center; }

  .cg-door { position: relative; width: 3.2em; }
  .cg-door-frame {
    position: absolute; inset: 0;
    border-left: 3px solid var(--aas-border); border-right: 3px solid var(--aas-border);
    border-radius: 4px;
  }
  .cg-bar {
    position: absolute; left: 6%; right: 6%; top: 8%;
    height: 0%;
    background: repeating-linear-gradient(45deg, var(--cg-warn), var(--cg-warn) 8px, var(--aas-panel) 8px, var(--aas-panel) 16px);
    border-radius: 4px; border: 1px solid var(--cg-warn);
    opacity: 0;
    transition: height 0.4s ease, opacity 0.3s ease;
  }
  .cg-stage.is-asks .cg-bar { height: 84%; opacity: 1; }
  .cg-gate-label {
    position: absolute; left: 50%; bottom: 0.4em; transform: translateX(-50%);
    display: none;
  }

  .cg-out { display: grid; align-content: start; gap: 0.6em; min-height: 10em; }
  .cg-human {
    padding: 0.6em 0.8em; border-radius: 10px;
    border: 1.5px solid var(--cg-strong);
    background: color-mix(in srgb, var(--cg-strong) 10%, var(--aas-panel));
    display: grid; gap: 0.45em;
    font-size: 0.84em; color: var(--aas-text); font-weight: 600;
    animation: cg-pop 0.25s ease-out;
  }
  @keyframes cg-pop { from { transform: scale(0.9); opacity: 0; } }
  .cg-human div { display: flex; gap: 0.4em; }
  .cg-human button {
    padding: 0.3em 0.9em; border-radius: 999px;
    border: 1px solid var(--aas-border); background: var(--aas-panel);
    color: var(--aas-text); font-family: inherit; font-size: 0.92em; cursor: pointer;
  }
  .cg-human [data-approve] { border-color: var(--cg-ok); color: var(--cg-ok); font-weight: 650; }
  .cg-human [data-reject] { border-color: var(--cg-warn); color: var(--cg-warn); font-weight: 650; }

  .cg-result { font-size: 0.84em; color: var(--aas-text); font-weight: 600; min-height: 1.6em; }

  .cg-foot { margin: 0.6em 0 0; font-size: 0.82em; line-height: 1.65; color: var(--aas-muted); }

  @media (max-width: 34rem) {
    .cg-stage { grid-template-columns: 1fr; }
    .cg-meter-track { min-height: 5em; }
    .cg-stage.is-passing .cg-card, .cg-stage.is-approved .cg-card { transform: translateY(0); opacity: 0.35; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cg-card, .cg-meter-fill, .cg-bar { transition: none; }
  }
</style>
