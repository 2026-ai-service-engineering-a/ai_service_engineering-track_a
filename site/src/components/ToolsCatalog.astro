---
/**
 * "사용 도구" 페이지에 임베드하는 도구 카드 그리드. 테마의 StackCard를 그대로
 * 쓰되, CategoryIndex의 브레드크럼·필터·중복 h1 없이 하위 카테고리별로 카드만
 * 렌더한다 (nav 페이지는 PageDetail이 이미 제목 h1을 그린다).
 */
import StackCard from 'stack-site-builder/components/StackCard.astro';
import { getStacksByCategory, slugOf, type StackEntry } from 'stack-site-builder/lib/stacks';
import { childrenOf } from '@aas-data/categories';
import type { Lang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 렌더할 로케일 — 이 사이트는 ko 단일. */
  lang?: Lang;
  /** 부모 카테고리 id — 이 노드의 하위 카테고리별로 도구를 묶어 보여준다. */
  root?: string;
}

const { lang = 'ko', root = 'tools' } = Astro.props;

const cardProps = (e: StackEntry) => ({
  slug: slugOf(e),
  lang,
  name: e.data.name,
  formerNames: e.data.formerNames,
  vendor: e.data.vendor,
  description: e.data.description,
  tags: e.data.tags,
  pricing: e.data.pricing,
  license: e.data.license,
  language: e.data.language,
  category: e.data.category,
  logo: e.data.logo,
  logoDark: e.data.logoDark,
  repo: e.data.repo,
  version: e.data.version,
  deprecated: e.data.deprecated,
});

const groups = await Promise.all(
  childrenOf(root).map(async (c) => ({ cat: c, items: await getStacksByCategory(lang, c.id) })),
);
---

<div class="not-prose">
  {
    groups.map((g) => (
      <section class="mb-10">
        <h2 class="mb-1 text-xl font-bold tracking-tight">{g.cat.label[lang]}</h2>
        <p class="mb-4 text-[var(--aas-muted)]">{g.cat.description[lang]}</p>
        <div class="grid gap-4 sm:grid-cols-2">
          {g.items.map((e) => (
            <StackCard {...cardProps(e)} />
          ))}
        </div>
      </section>
    ))
  }
</div>
